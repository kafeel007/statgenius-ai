# Copy to .env (never commit .env). Keys stay on the server.
SECRET_KEY=change-me-to-a-long-random-string
# Optional: enables real AI features. Leave empty for deterministic demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
